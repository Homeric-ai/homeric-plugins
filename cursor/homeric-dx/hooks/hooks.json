{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/session-start.mjs\" --client cursor",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/session-digest.mjs\" --client cursor --record",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/session-digest.mjs\" --client cursor --record",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/session-digest.mjs\" --client cursor",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
